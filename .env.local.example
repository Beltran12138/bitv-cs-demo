NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# DeepSeek (existing)
DEEPSEEK_API_KEY=sk-...

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Lark integration (v7) ───────────────────────────────────────────────────
# Get from open.feishu.cn → BitV CS Demo app → Credentials & Basic info
LARK_APP_ID=cli_xxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: AES-256-CBC encryption key (leave blank for demo)
LARK_ENCRYPT_KEY=

# CS group chat_id (oc_xxx) — from group settings
LARK_CS_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# BitV CS Demo customer base
LARK_BASE_APP_TOKEN=bascxxxxxxxxxxxxxxxxxxxxxxx
LARK_BASE_TABLE_ID=tblxxxxxxxxxxxxxxxxxxxxxxxxxx
